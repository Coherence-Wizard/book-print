{
  "name": "obsidian-plugin",
  "version": "0.0.3",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && node ../../scripts/build-plugin.mjs",
    "dev": "esbuild src/main.ts --bundle --external:obsidian --external:electron --external:@electron/remote --platform=node --format=cjs --target=es2022 --outfile=main.js --watch"
  },
  "dependencies": {
    "@book-print/shared": "1.0.0",
    "@book-print/markdown": "1.0.0",
    "@book-print/book-layout": "1.0.0",
    "@book-print/pdf": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.3.3",
    "@electron/remote": "^2.1.3",
    "electron": "^44.5.1"
  },
  "private": true,
  "license": "MIT"
}
